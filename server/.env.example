# PlantNanny Server Environment Configuration
# ============================================
# Copy this file to .env and customize for your environment

# ===================
# Server Configuration
# ===================

# Server host and port
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Enable development features (fake data seeding)
DEV_SEED_DATA=true

# ===================
# MQTT Configuration
# ===================

# MQTT Broker connection
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# MQTT Credentials (server uses full access credentials)
MQTT_USERNAME=plantnanny_server
MQTT_PASSWORD=server_secret_2024

# Disable MQTT (for testing without broker)
MQTT_DISABLED=false

# ===================
# Security
# ===================

# Firebase/Auth configuration (for production)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_API_KEY=your-api-key

# JWT Secret (for development without Firebase)
JWT_SECRET=dev-secret-change-in-production

# ===================
# Logging
# ===================

LOG_LEVEL=INFO
